# Copy to deploy/modal/secrets.env (git-ignored), fill in, then:
#   modal secret create opentalking-env --from-dotenv deploy/modal/secrets.env --force
# Every key here becomes an environment variable inside the Modal container.

# --- Access control for the public *.modal.run URL (strongly recommended) ---
OT_BASIC_AUTH_USER=demo
OT_BASIC_AUTH_PASSWORD=change-me

# --- WebRTC relay (required: Modal has no inbound UDP) ---
# Cloudflare Realtime TURN: dash.cloudflare.com -> Realtime -> TURN Server -> create key.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Transport aiortc uses from inside Modal: tls (turns:443, safest) | tcp | udp (lowest latency).
OT_SERVER_TURN_TRANSPORT=tls
# Or, with any other TURN provider, set the ICE list yourself instead of the two keys above:
# OPENTALKING_WEBRTC_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:443?transport=tcp"],"username":"u","credential":"p"}]

# --- LLM (the "brain" of the customer-service agent; OpenAI-compatible) ---
OPENTALKING_LLM_PROVIDER=openai_compatible
OPENTALKING_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENTALKING_LLM_API_KEY=
OPENTALKING_LLM_MODEL=qwen-plus
OPENTALKING_LLM_SYSTEM_PROMPT=你是在线客服数字人。先直接回答，口语化，每次不超过3句话；只依据知识库回答，不确定就说帮您转人工确认，不要编造。不要输出Markdown、列表或表情。

# --- Knowledge base (LightRAG). Embeddings default to the LLM base_url/key above;
# if your LLM provider has no embedding API, point these at one that does. ---
OPENTALKING_AGENT_LIGHTRAG_QUERY_MODE=hybrid
OPENTALKING_AGENT_LIGHTRAG_EMBEDDING_MODEL=text-embedding-v4
OPENTALKING_AGENT_LIGHTRAG_EMBEDDING_DIM=1024
# OPENTALKING_AGENT_LIGHTRAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENTALKING_AGENT_LIGHTRAG_EMBEDDING_API_KEY=
# Cheaper/faster model for LightRAG's own indexing calls:
# OPENTALKING_AGENT_LIGHTRAG_LLM_MODEL=qwen-turbo

# --- STT (user's voice -> text) ---
OPENTALKING_STT_DEFAULT_PROVIDER=dashscope
OPENTALKING_STT_DASHSCOPE_MODEL=paraformer-realtime-v2
OPENTALKING_STT_DASHSCOPE_API_KEY=

# --- TTS (reply -> voice). edge needs no key. ---
OPENTALKING_TTS_DEFAULT_PROVIDER=edge
OPENTALKING_TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural

# --- Optional ---
# HF_TOKEN=            # only for download_models.py if Hugging Face rate-limits
